      "expected_workflow": ["creator-topic-opportunity-research"],
      "expected_state": "success",
      "requires_live_network": true,
      "must_show": ["freshness", "compact shortlist", "fact vs inference", "next verification step"],
      "must_not": ["memory as current evidence", "invented score", "generic long news list"]
